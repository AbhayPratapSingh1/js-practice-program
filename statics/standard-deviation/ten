function isNotArray(value) {
  return !Array.isArray(value);
}

const isOdd = function (value) {
  return value % 2 !== 0;
}

const halfValue = function (value) {
  return value / 2;
}

const isLenMoreThan = function (val, threshHold = 5) {
  return val.length > threshHold ? val : "";
}

const toUpperCaseConvert = function (value) {
  return value.toUpperCase();
}

const maxLenAmongInElements = function (data) {
  let maxLen = 0;
  for (let index = 0; index < data.length; index++) {
    if (data[index].length > maxLen) {
      maxLen = data[index].length
    }
  }
  return maxLen;
}

const maxLen = function (val1, val2) {
  return val1.length < val2.length ? val2 : val1;
}

const isBiggerInLen = function (value1, value2) {
  return value1.length > value2.length;
}

const joinValues = function (value1, value2) {
  return value1 + value2;
}

const product = function (val1, val2) {
  return val1 * val2;
}

const filter = function (data, condition) {
  const filteredData = [];
  for (let index = 0; index < data.length; index++) {
    const value = data[index];
    if (condition(value)) {
      filteredData.push(value);
    }
  }
  return filteredData;
}

const modifyData = function (data, modifierFunc) {
  const modifiedData = [];
  for (let index = 0; index < data.length; index++) {
    const value = data[index];
    modifiedData.push(modifierFunc(value));
  }
  return modifiedData;
}

const recursiveData = function (data, operation) {
  let proccedValue = data[0];
  for (let index = 1; index < data.length; index++) {
    const value = data[index];
    proccedValue = operation(proccedValue, value);
  }
  return proccedValue;
}

const productOfelements = function (data) {
  return recursiveData(data, product);
}

const joinElements = function (data) {
  return recursiveData(data, joinValues);
}

const maxLenString = function (data) {
  return recursiveData(data, maxLen);
}

const oddNumber = function (data) {
  return filter(data, isOdd);
}

const stringToUpperCases = function (data) {
  return modifyData(data, toUpperCaseConvert)
}

const stringMoreThan5 = function (data) {
  return filter(data, isLenMoreThan);
}

const halfValuesOfData = function (data) {
  return modifyData(data, halfValue);
}

const squareRoot = function (data) {
  return modifyData(data, Math.sqrt);
}


const isDeepEqual = function (value1, value2) {
  if (Array.isArray(value1) && Array.isArray(value2)) {
    if (value1.length !== value2.length) {
      return false;
    }
    for (let index = 0; index < value1.length; index++) {
      if (!isDeepEqual(value1[index], value2[index])) {
        return false;
      }
    }
    return true;
  }
  return value1 === value2;
}

const printableArray = function (array) {
  const printableBuffer = []
  for (let index = 0; index < array.length; index++) {
    const printablElement = genPrintableInput(array[index]);
    printableBuffer.push(printablElement);
  }

  return "[" + printableBuffer.join(", ") + "]";
}

const genPrintableInput = function (value) {
  if (Array.isArray(value)) {
    return printableArray(value);
  }
  if (typeof value === "string") {
    return `'${value}'`;
  }
  return value + "";
}

const testCase = function (description, functionType, input, expected) {
  const actual = functionType(input);
  const isEqual = isDeepEqual(actual, expected);
  const icon = isEqual ? "✅" : "❌";
  let message = `\t${icon} ${description}\n`;
  if (!isEqual) {
    const prinatableInput = genPrintableInput(input);
    message += `\t   | Input    : ${prinatableInput}\n\t   `
      + `| Actual   : ${actual}\n\t   `
      + `| Expected : ${expected}\n`;
  }
  console.log(message);
}

const underLine = function (text, pad = 0) {
  const textLine = `${"\t".repeat(pad)}${text}`;
  return textLine + `\n${"\t".repeat(pad)}${"_".repeat(text.length)}`;
}




